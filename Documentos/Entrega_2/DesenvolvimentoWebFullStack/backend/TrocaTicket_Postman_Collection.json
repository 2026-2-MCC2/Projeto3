        {
          "name": "Cadastrar organizador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Empresa Teste\",\n  \"email\": \"{{orgEmail}}\",\n  \"senha\": \"{{userPassword}}\",\n  \"perfil\": \"ORGANIZADOR\",\n  \"cnpj\": \"{{orgCnpj}}\",\n  \"telefone\": \"11999999999\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Use um e-mail e CNPJ ainda não cadastrados. O cadastro começa PENDENTE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cadastro criado\", () => pm.expect(pm.response.code).to.be.oneOf([201, 200]));",
                  "const d=pm.response.json(); if(d.id) pm.collectionVariables.set(\"organizerId\", String(d.id));"
                ]
              }
            }
          ]
        },
